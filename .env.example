# Mascardi Lifestyle — environment configuration
# Copy this file to .env and fill in real values.
#
# WHERE THIS FILE LIVES: next to the app/ folder.
#   - Local development: the project root (same folder as this example).
#   - cPanel production: your HOME directory (/home/<user>/.env) — the deploy
#     copies app/ etc. to the home directory, and .env sits beside them.
#     NEVER place .env inside the web root.

# --- Application ---
# APP_ENV: development | production ("production" hides error details from visitors)
APP_ENV=production
APP_URL=https://mascardilifestyle.co.ke
APP_NAME="Mascardi Lifestyle"
# Random 32+ character secret. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Database (from cPanel -> MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- M-Pesa Daraja (https://developer.safaricom.co.ke) ---
# MPESA_ENV: sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test shortcode is 174379; replace with your live Paybill/Till for production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS base URL Safaricom calls back to (no trailing slash).
MPESA_CALLBACK_BASE_URL=https://mascardilifestyle.co.ke
